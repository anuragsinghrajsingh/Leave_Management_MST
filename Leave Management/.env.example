DJANGO_SECRET_KEY=replace-this-with-a-long-random-production-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Production database example:
DB_ENGINE=postgresql
DB_NAME=leave_management
DB_USER=leave_user
DB_PASSWORD=replace-this-db-password
DB_HOST=localhost
DB_PORT=5432

# Development defaults when DJANGO_DEBUG=True:
# DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3

# Future MySQL example:
# DB_ENGINE=mysql
# DB_NAME=leave_management
# DB_USER=leave_user
# DB_PASSWORD=replace-this-db-password
# DB_HOST=localhost
# DB_PORT=3306

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Leave application timing rules
# Short/Half leave for today can be submitted after this notice window.
SHORT_HALF_LEAVE_MIN_NOTICE_MINUTES=15
SHORT_HALF_LEAVE_GRACE_MINUTES=5

# Sick leave for today is blocked at/after this local time. Use 24-hour time; 11:59 means 11:59 AM.
SICK_LEAVE_SAME_DAY_CUTOFF_TIME=11:59
