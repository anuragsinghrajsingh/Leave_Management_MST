DJANGO_SECRET_KEY=replace-this-with-a-long-random-production-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SESSION_COOKIE_SECURE=True
PORTAL_BASE_URL=https://yourdomain.com
ADMIN_EMAIL=admin@example.com

# Production database example:
DB_ENGINE=postgresql
DB_NAME=leave_management
DB_USER=leave_user
DB_PASSWORD=replace-this-db-password
DB_HOST=localhost
DB_PORT=5432

# Local development option: set DJANGO_DEBUG=True and use SQLite:
# DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3

# Future MySQL example:
# DB_ENGINE=mysql
# DB_NAME=leave_management
# DB_USER=leave_user
# DB_PASSWORD=replace-this-db-password
# DB_HOST=localhost
# DB_PORT=3306

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
LEAVE_DESK_FROM_EMAIL=your-email@gmail.com
LEAVE_RECORD_EMAILS=leave@example.com,leave-records@example.com

# Browser/system notification Web Push keys
# Generate with: python App/management/production_setup/generate_webpush_keys.py
WEB_PUSH_VAPID_PUBLIC_KEY=replace-this-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=runtime/webpush_private_key.pem
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# Security limits
# Maximum accepted password input length. Prevents very long password DoS attempts.
PASSWORD_INPUT_MAX_LENGTH=128

# Leave application timing rules
# Short/Half leave for today can be submitted after this notice window.
SHORT_HALF_LEAVE_MIN_NOTICE_MINUTES=15
SHORT_HALF_LEAVE_GRACE_MINUTES=5

# Sick leave for today is allowed through this local minute; the next minute is blocked. Use 24-hour time; 11:59 means 11:59 AM, so 12:00 PM is blocked.
SICK_LEAVE_SAME_DAY_CUTOFF_TIME=11:59

# Django-Q background worker tuning
LMS_Q_WORKERS=2
LMS_Q_TIMEOUT=120
LMS_Q_RETRY=300
LMS_Q_QUEUE_LIMIT=100
LMS_Q_BULK=20
